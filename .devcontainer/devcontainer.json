{
  "name": "Cyber Challenge Lab — ScamAlert",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": { "files.autoSave": "afterDelay" }
    }
  },
  "onCreateCommand": {
    "webapp": "cd webapp && npm ci",
    "zip": "command -v zip >/dev/null || (sudo apt-get update -qq && sudo apt-get install -y -qq zip)"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "ScamAlert (npm run dev)", "onAutoForward": "openBrowser" }
  },
  "hostRequirements": { "cpus": 2 }
}
