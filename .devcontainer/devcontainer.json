{
  "name": "Cyber Challenge Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "files.autoSave": "afterDelay",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.kernels.excludePythonEnvironments": ["/usr/bin/python3", "/bin/python3"]
      }
    }
  },
  "onCreateCommand": {
    "python": "pip install --no-cache-dir -r requirements.txt ipykernel && python -m ipykernel install --user --name python3 --display-name 'Python 3.11 (lab)'",
    "webapp": "cd webapp && npm ci"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "ScamAlert (npm run dev)", "onAutoForward": "openBrowser" }
  },
  "hostRequirements": { "cpus": 2 }
}
