# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Foundry resource ของคุณ (ไฟล์ .env.local ไม่ถูก commit)
FOUNDRY_API_KEY=
FOUNDRY_RESOURCE=
# ชื่อ deployment สองตัวเดียวกับใน notebook
TRIAGE_MODEL=gpt-5.4-mini
DEEP_MODEL=gpt-5.5
# deployment ของโมเดลถอดเสียง (ใช้กับอัปโหลดไฟล์เสียงและโหมดฟังสาย)
TRANSCRIBE_MODEL=gpt-4o-transcribe

